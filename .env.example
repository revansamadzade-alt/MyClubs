# ClubFund (optional). Public client settings only: never put secret or service-role keys here.
# Copy to .env.local (ignored by git) and fill in from Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Optional: a dedicated Solana Devnet RPC endpoint (must be Devnet; ClubFund checks the genesis hash).
# VITE_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
